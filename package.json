{
	"name": "intragram-scrap",
	"version": "0.0.1",
	"type": "module",
	"description": "This is an example of an Apify Actor.",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@crawlee/playwright": "^3.15.3",
		"apify": "^3.7.2",
		"crawlee": "^3.18.2",
		"playwright": "1.61.1"
	},
	"devDependencies": {
		"@apify/eslint-config": "^2.0.0",
		"@apify/tsconfig": "^0.2.0",
		"@types/node": "^24.0.0",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"globals": "^17.0.0",
		"prettier": "^3.5.3",
		"tsx": "^4.20.3",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.58.0",
		"vitest": "^5.0.0"
	},
	"scripts": {
		"start": "npm run start:dev",
		"start:prod": "node dist/main.js",
		"start:dev": "npm run build && node dist/main.js",
		"build": "tsc",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:browser": "npm run build && node test/extraction.browser.mjs",
		"postinstall": "npx crawlee install-playwright-browsers"
	},
	"author": "It's not you it's me",
	"license": "ISC"
}
